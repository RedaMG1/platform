# Local Postgres, started with: docker compose up -d
DATABASE_URL=postgresql://forma:forma_dev_password@localhost:5433/forma

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# Cloudflare R2 (S3-compatible). Leave all blank to use local disk uploads
# during development — the storage adapter stays disabled until R2_BUCKET is set.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Stripe (wired up when billing is connected)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
